# Everything here is OPTIONAL: the assistant starts with an empty .env and
# can be fully configured at runtime through the setup API (/api/setup, see
# README "Quick start"). Env values act as defaults; runtime overrides made
# through the API are stored in Redis and take priority.

# --- Bootstrap (env-only, need a restart to change) ---
REDIS_URL=redis://redis:6379
# Qdrant for the vector store (optional). Leave empty to run Redis-only — the
# vector features stay off and the assistant works as before.
#QDRANT_URL=http://qdrant:6333
LOG_LEVEL=INFO
# Directory with prompt overrides: <PROMPTS_DIR>/intake/<prompt_name>.md
# shadows the packaged default of the same name. Leave empty to use defaults.
#PROMPTS_DIR=

# --- Installation-wide switches (also editable via PATCH /api/setup/platform) ---
# Dry run: runs happen exactly as they would in production — tickets are
# classified, questions and handoff notes are composed, the run journal records
# every step — but nothing is written to iTop. Switch it on to watch what the
# assistant would do on your own tickets before letting it act.
DRY_RUN=false

# --- Security (also editable via PATCH /api/setup/security) ---
# Shared secret for webhook authentication (recommended). When set, iTop must
# send this value in the X-Auth-Token header of every webhook call.
# When empty, /webhook accepts unauthenticated requests.
WEBHOOK_TOKEN=
# Shared secret for the /api admin endpoints (bearer token: Authorization header).
# When empty, the admin API accepts unauthenticated requests (first-run mode).
ADMIN_TOKEN=

# --- iTop connection (also editable via PATCH /api/setup/itop) ---
ITOP_URL=http://itop/webservices/rest.php
ITOP_USER=
ITOP_PWD=
ITOP_TOKEN=

# --- LLM (also editable via PATCH /api/setup/llm) ---
# LLM_PROVIDER picks which fields matter:
#   openai_compatible (default) — any OpenAI-compatible URL; needs LLM_BASE_URL,
#       key optional. LM Studio: http://localhost:1234/v1 (LLM_API_KEY=lm-studio)
#       LiteLLM Proxy: http://litellm:4000/v1 (any string as key)
#       vLLM, DeepSeek, Azure OpenAI, OpenRouter — same way
#   openai       — no base URL, LLM_API_KEY=sk-... required
#   google_genai — no base URL, LLM_API_KEY=<Gemini API key> required
#   ollama       — LLM_BASE_URL=http://localhost:11434 (native API, no /v1), no key
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=
LLM_API_KEY=
# Extra client parameters as JSON, e.g. {"temperature": 0.2, "max_tokens": 2048}
LLM_PARAMS=
# Only for openai_compatible, where the provider cannot know: does the server
# accept a forced tool_choice? vLLM/LiteLLM/LM Studio do, DeepSeek returns
# HTTP 400. Verify with POST /api/setup/test-llm. Unset = do not force.
LLM_SUPPORTS_FORCED_TOOL_CHOICE=

# --- Observability (optional) ---
# Self-hosted LLM tracing: the prompt and the raw model answer, kept inside the
# perimeter. Off by default; the receiver runs only with a profile:
#   docker-compose --profile tracing up -d
# Traces contain ticket text — read docs/configuration.md before enabling this
# anywhere near real customer data.
TRACING_ENABLED=false
# OTLP/HTTP, full path to /v1/traces — a bare host:port or the gRPC port
# (:4317) exports nothing.
TRACING_ENDPOINT=http://phoenix:6006/v1/traces
TRACING_PROJECT_NAME=itop-ai-assistant

# The cloud path. Still supported for development against synthetic data, and
# off by default — it sends ticket text to a third party (ADR-029).
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
