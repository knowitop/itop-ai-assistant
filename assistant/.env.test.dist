# Integration test environment — copy to .env.test and fill in real values.
# .env.test is gitignored.
#
# These settings override config.yaml for integration test runs.
# LLM must be reachable when running: uv run pytest test/integration/

# openai_compatible (default) | openai | google_genai | ollama
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=your-model-name
LLM_API_KEY=none
# Set true if the endpoint accepts a forced tool_choice (vLLM yes, DeepSeek no)
# LLM_SUPPORTS_FORCED_TOOL_CHOICE=true

# Dummy iTop credentials — real iTop is NOT used (mocked via httpx transport)
ITOP_USER=dummy
ITOP_PWD=dummy
